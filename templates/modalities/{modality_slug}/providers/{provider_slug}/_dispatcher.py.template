"""{Provider} {modality} client (selects a wire backend at construction).

Use only when one provider serves two or more wire APIs; single-backend
providers use client.py.template. The PROVIDERS registry entry stays
{Provider}{Modality}Client — the registry never branches.
"""

from typing import Any, ClassVar

from celeste.providers.{provider_slug}.{api1_slug}.config import BASE_URL

from ...client import {Modality}Client
from .{api1_slug} import {Provider}{Api1}{Modality}Client
from .{api2_slug} import {Provider}{Api2}{Modality}Client


class {Provider}{Modality}Client({Modality}Client):
    """{Provider} {modality} client: constructing it returns the {Api1} or {Api2} backend."""

    _default_base_url: ClassVar[str] = BASE_URL

    def __new__(cls, **data: Any) -> Any:
        # Selection axes used in-repo:
        #   by auth:     if isinstance(data["auth"], {Provider}ADC): return {Api2}...(**data)
        #   by model id: if data["model"].id in _{API1}_MODEL_IDS: return {Api1}...(**data)
        #                ... then raise ValueError(f"Unknown {Provider} {modality} model: ...")
        return {Provider}{Api1}{Modality}Client(**data)


__all__ = ["{Provider}{Modality}Client"]
