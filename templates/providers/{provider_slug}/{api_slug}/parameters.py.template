"""{Provider} {Api} API parameter mappers.

Naming convention:
- Mapper class name MUST match the provider's API parameter name
- Example: API param "tools" → class ToolsMapper (not ToolMapper)
- Example: API param "aspectRatio" → class AspectRatioMapper
- The request key should match the provider's expected field name exactly
"""

from celeste.parameters import FieldMapper


# PATTERN 1: Simple flat mapping
# Use when provider expects flat request body: {"param": value}
class ExampleParamMapper[Content](FieldMapper[Content]):
    """Map example_param to {Provider} example_param field."""

    # Key matches API parameter name exactly
    field = "example_param"


# PATTERN 2: Nested mapping
# Use when provider expects nested structure: {"parameters": {"param": value}}
class NestedParamMapper[Content](FieldMapper[Content]):
    """Map nested_param to {Provider} parameters.nestedParam field."""

    # Dots nest; keys match API parameter names exactly (camelCase for this provider)
    field = "parameters.nestedParam"


__all__ = [
    "ExampleParamMapper",
    "NestedParamMapper",
]
